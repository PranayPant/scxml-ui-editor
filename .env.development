# OpenTelemetry trace ingestion endpoint. Points at the OpenTelemetry
# Collector (scxml-http-server/otel/otelcol-config.yaml) which forwards to
# Jaeger (http://localhost:16686) for the waterfall UI.
#
# Fallback (no collector running): uncomment the line below to emit to the
# Vite dev server middleware instead, which renders an ASCII span tree in the
# terminal and writes raw JSON to .otlp-traces.log.
VITE_OTLP_TRACE_ENDPOINT="http://localhost:4318/v1/traces"
# VITE_OTLP_TRACE_ENDPOINT="http://localhost:5173/api/logs"